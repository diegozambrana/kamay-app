# Variables de entorno de Kamay. Ningún valor real aquí: cada ambiente tiene
# el suyo y ningún valor de un ambiente se usa en otro (KAM-23).
#
#   · Desarrollo      → .env.local (valores de `supabase status`).
#   · Vista previa    → Vercel, ambiente «Preview». Nunca las llaves de producción.
#   · Producción      → Vercel, ambiente «Production».
#
# `lib/env.ts` las valida al arrancar el servidor (`instrumentation.ts`): si
# falta una requerida, Kamay no arranca y el registro dice cuál. En desarrollo
# bastan las tres de Supabase; en una compilación de producción —`next start`,
# Vercel— también CRON_SECRET y APP_URL.

# ── Supabase ────────────────────────────────────────────────────────────────
# Local: `supabase status` (Publishable → ANON, Secret → SERVICE_ROLE).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Salta RLS. Solo la leen los trabajos programados y la generación de avisos,
# en el servidor. Nunca con prefijo NEXT_PUBLIC_: `lib/env.ts` se niega a
# arrancar si una variable pública la contiene, y `npm run check:bundle` falla
# si aparece en lo que se sirve al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Enlaces ─────────────────────────────────────────────────────────────────
# La dirección pública de la aplicación. La usan los enlaces de los correos de
# aviso: sin ella el correo se rinde sin enlace en vez de apuntar a localhost.
# Requerida en producción.
APP_URL=http://localhost:3010

# ── Trabajos programados ────────────────────────────────────────────────────
# Autoriza el disparo de `GET /api/notifications/daily` (cada hora) y de
# `GET /api/activity/retention` (mensual), que el Cron de Vercel llama con
# `Authorization: Bearer $CRON_SECRET`. **Sin secreto configurado los dos
# rechazan todo**, incluido el propio Cron: es deliberado, para que un
# despliegue mal configurado no quede abierto. Requerida en producción, con al
# menos 16 caracteres: `openssl rand -hex 24`.
CRON_SECRET=

# ── Correo ──────────────────────────────────────────────────────────────────
# Correo transaccional (Resend, vía el Marketplace de Vercel). Opcional:
# mientras no esté provisionada, los avisos se generan igual y no se envía
# ningún correo. La bandeja es la garantía y el correo el refuerzo.
RESEND_API_KEY=
