# Supabase — valores locales: `supabase status` (Publishable → ANON, Secret → SERVICE_ROLE)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KAM-17 · Avisos y recordatorios
#
# La dirección pública de la aplicación. La usan los enlaces de los correos de
# aviso: sin ella el correo se rinde sin enlace en vez de apuntar a localhost.
APP_URL=http://localhost:3010

# Autoriza el disparo del trabajo programado (`POST /api/notifications/daily`).
# **Sin secreto configurado el manejador rechaza todo**, incluido el cron: es
# deliberado, para que un despliegue mal configurado no quede abierto.
CRON_SECRET=

# Correo transaccional (Resend, vía el Marketplace de Vercel). Mientras no esté
# provisionada, los avisos se generan igual y no se envía ningún correo: la
# bandeja es la garantía y el correo el refuerzo.
RESEND_API_KEY=
